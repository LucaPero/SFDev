<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Verify that the required conditions to begin a swarm are met.</description>
        <name>Check_Preconditions</name>
        <label>Check Preconditions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>chkSwarmingInSlackPrecond</actionName>
        <actionType>chkSwarmingInSlackPrecond</actionType>
        <connector>
            <targetReference>Submit_Swarm_Request</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Display_Error_Message</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>recordId</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>swarmActionType</name>
            <value>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
                <stringValue>Begin</stringValue>
            </value>
        </inputParameters>
        <nameSegment>chkSwarmingInSlackPrecond</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <description>Triggers a toast message confirming that the Swarm was created.</description>
        <name>Trigger_Swarm_Creation_Toast</name>
        <label>Trigger Swarm Creation Toast</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>flowruntime:showToastMessage</actionName>
        <actionType>lwcComponent</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>toastMessageTitle</name>
            <value>
                <elementReference>SwarmCreationToastMessage</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>toastMessageBody</name>
        </inputParameters>
        <inputParameters>
            <name>dismissalMethod</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>Automatic</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>toastMessageStyle</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>Success</stringValue>
            </value>
        </inputParameters>
        <nameSegment>flowruntime:showToastMessage</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <description>Checks if the Begin Swarm subflow returned an error message.</description>
        <name>Any_error_while_initiating_Swarm</name>
        <label>Any Error When Beginning Swarm?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Display_Error_Message_Start_Swarm</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Error on Start Swarm</defaultConnectorLabel>
        <rules>
            <name>No_Error_Start_swarm</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Initiate_Swarm_in_Slack.errorMessage</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Initiate_Swarm_in_Slack.errorMessage</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Trigger_Swarm_Creation_Toast</targetReference>
            </connector>
            <label>No Error</label>
        </rules>
    </decisions>
    <environments>Slack</environments>
    <formulas>
        <description>Toast message to confirm swarm record creation.</description>
        <name>SwarmCreationToastMessage</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!SwarmCreationToastTemplate}, &quot;{0}&quot;, {!SwarmRecordName})</expression>
    </formulas>
    <interviewLabel>Begin Swarming For Slack {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Begin Swarming For Slack</label>
    <overriddenFlow>swarming__Begin_Enhanced_Slack_Swarm</overriddenFlow>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <description>Displays the error message from the Check Preconditions subflow.</description>
        <name>Display_Error_Message</name>
        <label>Display Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Precondition_Error_Message</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Flow.FaultMessage}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Displays the error message from the Begin Swarming for Slack flow.</description>
        <name>Display_Error_Message_Start_Swarm</name>
        <label>Display Begin Swarm Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Start_swarm_Error_Message</name>
            <fieldText>&lt;p&gt;{!Initiate_Swarm_in_Slack.errorMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Submits a request to initiate a swarm.</description>
        <name>Submit_Swarm_Request</name>
        <label>Submit Swarm Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Initiate_Swarm_in_Slack</targetReference>
        </connector>
        <fields>
            <name>SwarmRecordName</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Check_Preconditions.defaultSwarmRecordName</elementReference>
            </defaultValue>
            <fieldText>Swarm Record Name</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>SwarmDescription</name>
            <fieldText>What do you need help with?</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>ResetValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Enter 2500 characters or fewer&lt;/p&gt;</errorMessage>
                <formulaExpression>LEN(BLANKVALUE({!SwarmDescription}, &quot;&quot;)) &lt;= 2500</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>SlackChannelSelector</name>
            <extensionName>runtime_slack:slackChannelSelector</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>placeholder</name>
                <value>
                    <stringValue>Select an expert channel...</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Expert Channel</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>isRequired</name>
                <value>
                    <booleanValue>false</booleanValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Start Swarm</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Preconditions</targetReference>
        </connector>
    </start>
    <status>InvalidDraft</status>
    <subflows>
        <description>Starts a swarm conversation in Slack.</description>
        <name>Initiate_Swarm_in_Slack</name>
        <label>Begin Swarm in Slack</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Any_error_while_initiating_Swarm</targetReference>
        </connector>
        <flowName>swarming__Init_Enhanced_Slack_Swarm</flowName>
        <inputAssignments>
            <name>expertSlackChannelId</name>
            <value>
                <elementReference>SlackChannelSelector.selectedChannelId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>expertSlackChannelName</name>
            <value>
                <elementReference>SlackChannelSelector.selectedChannelName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>source</name>
            <value>
                <stringValue>Flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>swarmDescription</name>
            <value>
                <elementReference>SwarmDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>swarmName</name>
            <value>
                <elementReference>SwarmRecordName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>swarmOwnerSalesforceId</name>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <textTemplates>
        <description>Template for the toast message that confirms swarm creation.</description>
        <name>SwarmCreationToastTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{0} was created.</text>
    </textTemplates>
    <variables>
        <description>The ID of the record associated with the swarm.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

# Ask Nimbus — deterministic RAG-grounded FAQ agent for Nimbus Workspace.
# See Ask_Nimbus-AgentSpec.md at the project root for full design rationale.

system:
    instructions: |
        You are Ask Nimbus, an AI assistant for Nimbus Workspace customers.
        Always disclose that you are an AI assistant if asked. You answer
        questions about Nimbus Workspace billing, accounts, workspaces and
        projects, integrations and the API, data import/export and
        compliance, troubleshooting, and security and compliance — grounded
        only in the Nimbus Workspace knowledge base. You never give legal
        advice, medical advice, or disparage competitors, and you never
        discuss anything unrelated to Nimbus Workspace.
        Perform only the current operating task described in the active
        subagent's instructions below. Answer the user's question only when
        that task calls for an answer; otherwise route, ask a clarifying
        question, decline, or escalate exactly as directed, without also
        answering the underlying request in the same turn.
        You have exactly one write capability: creating or updating a support
        Case through the escalation hand-off. You cannot process refunds,
        change subscription plans, delete data, remove or modify users, or
        change any account record yourself — for any request to actually
        perform one of those changes, hand off to a human instead of
        attempting it or claiming you did it.
        Never answer a substantive question from your own training knowledge.
        Only use facts returned by the knowledge-search action for this
        conversation.
    messages:
        welcome: "Hi, I'm Ask Nimbus. I can help with billing, accounts, workspaces, integrations, data and compliance, troubleshooting, or security questions about Nimbus Workspace. What can I help you with?"
        error: "Sorry, something went wrong on my end. Please try again, or ask to speak with a specialist."

access:
    default_agent_user: "agentforce_service_agent@00daj00000uvhm5802865891.ext"

config:
    developer_name: "Ask_Nimbus"
    agent_label: "Ask Nimbus"
    description: "Deterministic RAG-grounded FAQ agent for Nimbus Workspace, grounded on Salesforce Knowledge, with a single escalation hand-off action."
    agent_type: "AgentforceServiceAgent"

variables:
    session_id: linked string
        source: @MessagingSession.Id
        description: "Current conversation session id. Idempotency key passed to escalateToHuman as sessionId."

    escalation_reason_code: mutable string = ""
        description: "Which deterministic escalation trigger fired, if any. Empty when no trigger is active. Consumed by every subagent's top-of-instructions redirect and by escalateToHuman's reasonCode input."

    pending_queue_hint: mutable string = ""
        description: "Domain queue hint (Billing/Technical/General/LegalTrust) recorded by whichever subagent triggered escalation. Consumed by escalateToHuman's queueHint input."

    retrieval_attempts: mutable number = 0
        description: "Consecutive empty AnswerQuestionsWithKnowledge results for the current topic. Reset on topic change. At 2, forces escalation with no_confident_answer."

    unresolved_turns: mutable number = 0
        description: "Count of low-confidence or user-flagged-unhelpful responses since the last topic change. At 3, forces escalation with unresolved_after_3_turns."

    clarifying_questions_asked: mutable number = 0
        description: "Consecutive clarifying questions asked for the current topic. Reset on topic change. Capped at 2 by subagent instructions."

    turn_count: mutable number = 0
        description: "Number of user turns handled by a domain subagent this session. At 12, subagent instructions proactively offer a human hand-off."

    active_domain: mutable string = ""
        description: "Developer name of the domain subagent most recently entered. Used by each domain subagent's before_reasoning to detect a topic change and reset the per-topic counters above."

    escalation_attempted: mutable boolean = False
        description: "Whether escalate_to_human has been called at least once for the current escalation. Consumed by the escalation subagent's retry-branch condition."

    escalation_case_created: mutable boolean = False
        description: "Trusted output of escalateToHuman.isSuccess. Gates escalate_to_human (hides it once True) and hand_off_to_human (shows it once True)."

    escalation_attempts: mutable number = 0
        description: "Number of escalate_to_human calls made for the current escalation. Caps repeated retries at 3 so a persistently failing Apex call cannot loop indefinitely within one turn."

connection messaging:
    outbound_route_type: "OmniChannelFlow"
    outbound_route_name: "flow://Ask_Nimbus_Outbound_Enhanced_Chat_Flow"
    escalation_message: "Transferring you to a live agent — please hold on a moment."
    adaptive_response_allowed: True

knowledge:
    rag_feature_config_id: "ARFPC_1JDaj00000MT7PdGAL"
    citations_enabled: True
    citations_url: ""

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    label: "Ask Nimbus Router"
    description: "Welcomes the user and classifies the current request into exactly one Nimbus Workspace support domain, the escalation path, or off-topic redirection. Never answers the underlying question itself."

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            | Welcome the user if this is the start of the conversation.
              Before classifying anything else, check the user's latest
              message for these deterministic triggers. If any apply, call
              exactly that trigger action immediately instead of routing to a
              domain, and do not answer the question in the same turn:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Mentions a suspicious login, account compromise, fraud, or a
                legal threat -> trigger_security_keyword.
              - Asks to delete personal data, invokes GDPR, or asks to be
                forgotten -> trigger_gdpr_request.
              - Directly asks you to carry out an irreversible account or
                billing change right now (for example "please cancel it",
                "go ahead and switch me"), not asking whether it is possible,
                what the options are, or how to do it themselves ->
                trigger_transactional_intent.
              - Requires reading the user's own account, invoice, or usage
                record, which the knowledge base cannot provide ->
                trigger_account_specific.
              Otherwise, classify the request into exactly one of the seven
              supported domains below and transition there without answering
              the underlying question. Never give legal advice, medical
              advice, disparage any competitor, or discuss anything unrelated
              to Nimbus Workspace — for any of those, or anything matching no
              supported domain, transition to off_topic instead.

        actions:
            go_to_billing: @utils.transition to @subagent.billing_subscriptions
                description: "Billing, invoices, charges, refund policy, subscription plan tiers, upgrades/downgrades between plans, payment methods, proration. Example: 'Why was I charged twice this month?', 'Can I switch from Team to Business plan?'."
            go_to_account: @utils.transition to @subagent.account_user_management
                description: "Login and password issues, multi-factor authentication, user provisioning/removal, roles and permissions. Example: 'I can't log in, forgot my password', 'Remove 80 users who left the company'."
            go_to_workspace: @utils.transition to @subagent.workspace_project_setup
                description: "Creating and configuring workspaces and projects, templates, folder structure, workspace settings. Example: 'How do I create a project from a template?'."
            go_to_integrations: @utils.transition to @subagent.integrations_api
                description: "API usage, authentication, rate limits, error codes, webhooks, third-party integrations. Example: 'Getting 429 errors from your API'."
            go_to_data_compliance: @utils.transition to @subagent.data_import_export_compliance
                description: "Importing/exporting data, backups, data retention, and personal-data or GDPR-related requests. Example: 'Please delete all my personal data', 'How do I export my workspace data to CSV?'."
            go_to_troubleshooting: @utils.transition to @subagent.troubleshooting
                description: "App crashes, error messages, performance problems, other technical malfunctions in the Nimbus Workspace apps. Example: 'App keeps crashing on iOS'."
            go_to_security: @utils.transition to @subagent.security_compliance
                description: "Account security, suspicious login activity, fraud concerns, compliance certifications (SOC 2, GDPR, ISO), trust-center questions. Example: 'I see a login from an unknown location', 'Are you SOC 2 compliant?'."
            go_to_off_topic: @utils.transition to @subagent.off_topic
                description: "Anything unrelated to Nimbus Workspace, or requests for legal advice, medical advice, or competitor comparisons, or anything matching none of the seven supported domains."
            trigger_human_request: @utils.setVariables
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "General"
            trigger_security_keyword: @utils.setVariables
                description: "Call immediately when the user mentions a suspicious login, account compromise, fraud, or a legal threat."
                set @variables.escalation_reason_code = "security_keyword"
                set @variables.pending_queue_hint = "General"
            trigger_gdpr_request: @utils.setVariables
                description: "Call immediately when the user asks to delete their personal data, invokes GDPR, or asks to be forgotten."
                set @variables.escalation_reason_code = "gdpr_request"
                set @variables.pending_queue_hint = "General"
            trigger_transactional_intent: @utils.setVariables
                description: "Call immediately when the user directly asks you to carry out an irreversible account or billing change right now (for example, 'please cancel my plan', 'go ahead and remove these users', 'issue the refund now') — not when they ask whether it is possible, what the options are, or how to do it themselves."
                set @variables.escalation_reason_code = "transactional_intent"
                set @variables.pending_queue_hint = "General"
            trigger_account_specific: @utils.setVariables
                description: "Call immediately when answering requires reading the user's own account, invoice, or usage record data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "account_specific"
                set @variables.pending_queue_hint = "General"

subagent billing_subscriptions:
    label: "Billing & Subscriptions"
    description: "Billing, invoices, charges, refund policy, subscription plan tiers, upgrades/downgrades between plans (for example Team to Business), payment methods, and proration questions. Example requests: 'Why was I charged twice this month?', 'Can I switch from Team to Business plan?', 'What happens to unused seats if I downgrade?'. Not for actually issuing a refund or changing a plan on the user's behalf — only for explaining how billing and plans work."

    before_reasoning:
        if @variables.active_domain != "billing_subscriptions":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "billing_subscriptions"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "Billing"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "Billing"
                transition to @subagent.escalation

            | Help the customer with billing, invoices, charges, refund
              policy, and subscription plan questions. You cannot process a
              refund, change a plan, or modify billing yourself — explain how
              it works and hand off for anything that requires actually doing
              it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with a billing specialist. If they accept,
                  call trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Suspicious login, account compromise, fraud, or a legal
                threat -> trigger_security_keyword.
              - Delete my data, GDPR, or right to be forgotten ->
                trigger_gdpr_request.
              - Directly asks you to carry out a refund, cancellation, or
                plan change right now (for example "please cancel my
                subscription", "go ahead and switch me to Business") — not
                asking whether it is possible, what the options are, or how
                to do it themselves -> trigger_transactional_intent.
              - Requires reading the user's own invoice, charge history, or
                account-specific billing data -> trigger_account_specific.

            | If you cannot tell which invoice, billing period, or plan tier
              the question concerns, or which product if the account may have
              more than one, ask exactly one clarifying question and call
              mark_clarifying_question_asked. After 2 clarifying questions
              without enough information, proceed with your best-effort
              answer using what you have, or call trigger_account_specific if
              you genuinely cannot help without the user's own account data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.setVariables
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "Billing"
            trigger_security_keyword: @utils.setVariables
                description: "Call immediately when the user mentions a suspicious login, account compromise, fraud, or a legal threat."
                set @variables.escalation_reason_code = "security_keyword"
                set @variables.pending_queue_hint = "Billing"
            trigger_gdpr_request: @utils.setVariables
                description: "Call immediately when the user asks to delete their personal data, invokes GDPR, or asks to be forgotten."
                set @variables.escalation_reason_code = "gdpr_request"
                set @variables.pending_queue_hint = "Billing"
            trigger_transactional_intent: @utils.setVariables
                description: "Call immediately when the user directly asks you to carry out a refund, cancellation, or plan change right now (for example, 'please cancel my subscription', 'go ahead and switch me to Business') — not when they ask whether it is possible, what the options are, or how to do it themselves."
                set @variables.escalation_reason_code = "transactional_intent"
                set @variables.pending_queue_hint = "Billing"
            trigger_account_specific: @utils.setVariables
                description: "Call immediately when answering requires reading the user's own invoice, charge history, or account-specific billing data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "account_specific"
                set @variables.pending_queue_hint = "Billing"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
            outputs:
                knowledgeSummary: object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

subagent account_user_management:
    label: "Account & User Management"
    description: "Login and password issues, multi-factor authentication, user provisioning and deprovisioning, roles and permissions within a Nimbus Workspace account. Example requests: 'I can't log in, forgot my password', 'Remove 80 users who left the company', 'How do I change a teammate's role?'. Not for actually deleting or modifying user records — only for explaining how account and user administration works."

    before_reasoning:
        if @variables.active_domain != "account_user_management":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "account_user_management"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "General"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "General"
                transition to @subagent.escalation

            | Help the customer with login, password, multi-factor
              authentication, user provisioning, and role/permission
              questions. You cannot reset a password, remove a user, or
              change a role yourself — explain how it works and hand off for
              anything that requires actually doing it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with a specialist. If they accept, call
                  trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Suspicious login, account compromise, fraud, or a legal
                threat -> trigger_security_keyword.
              - Delete my data, GDPR, or right to be forgotten ->
                trigger_gdpr_request.
              - Directly asks you to remove, add, or modify a user or role
                right now (for example "please remove these 80 users") — not
                asking whether it is possible or how to do it themselves ->
                trigger_transactional_intent.
              - Requires reading the user's own account or another specific
                user's account data -> trigger_account_specific.

            | If you cannot tell whether the question is about the user's own
              login or about administering other users, or which specific
              user(s) or role is involved, ask exactly one clarifying
              question and call mark_clarifying_question_asked. After 2
              clarifying questions without enough information, proceed with
              your best-effort answer using what you have, or call
              trigger_account_specific if you genuinely cannot help without
              the user's own account data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.setVariables
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "General"
            trigger_security_keyword: @utils.setVariables
                description: "Call immediately when the user mentions a suspicious login, account compromise, fraud, or a legal threat."
                set @variables.escalation_reason_code = "security_keyword"
                set @variables.pending_queue_hint = "General"
            trigger_gdpr_request: @utils.setVariables
                description: "Call immediately when the user asks to delete their personal data, invokes GDPR, or asks to be forgotten."
                set @variables.escalation_reason_code = "gdpr_request"
                set @variables.pending_queue_hint = "General"
            trigger_transactional_intent: @utils.setVariables
                description: "Call immediately when the user directly asks you to remove, add, or modify a user or role right now (for example, 'please remove these 80 users') — not when they ask whether it is possible or how to do it themselves."
                set @variables.escalation_reason_code = "transactional_intent"
                set @variables.pending_queue_hint = "General"
            trigger_account_specific: @utils.setVariables
                description: "Call immediately when answering requires reading the user's own account or another specific user's account data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "account_specific"
                set @variables.pending_queue_hint = "General"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
            outputs:
                knowledgeSummary: object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

subagent workspace_project_setup:
    label: "Workspace & Project Setup"
    description: "Creating and configuring workspaces and projects, using templates, folder structure, and workspace settings. Example requests: 'How do I create a project from a template?', 'How do I reorganize my workspace folders?', 'Can I set a default template for new projects?'."

    before_reasoning:
        if @variables.active_domain != "workspace_project_setup":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "workspace_project_setup"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "General"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "General"
                transition to @subagent.escalation

            | Help the customer create and configure workspaces, projects,
              and templates. You cannot create, modify, or delete a workspace
              or project yourself — explain how it works and hand off for
              anything that requires actually doing it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with a specialist. If they accept, call
                  trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Suspicious login, account compromise, fraud, or a legal
                threat -> trigger_security_keyword.
              - Delete my data, GDPR, or right to be forgotten ->
                trigger_gdpr_request.
              - Directly asks you to create, delete, or reconfigure a
                workspace or project right now — not asking whether it is
                possible or how to do it themselves ->
                trigger_transactional_intent.
              - Requires reading the user's own workspace or project
                configuration data -> trigger_account_specific.

            | If you cannot tell which workspace or project, or which
              template or setting, the question concerns, ask exactly one
              clarifying question and call mark_clarifying_question_asked.
              After 2 clarifying questions without enough information,
              proceed with your best-effort answer using what you have, or
              call trigger_account_specific if you genuinely cannot help
              without the user's own workspace data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.setVariables
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "General"
            trigger_security_keyword: @utils.setVariables
                description: "Call immediately when the user mentions a suspicious login, account compromise, fraud, or a legal threat."
                set @variables.escalation_reason_code = "security_keyword"
                set @variables.pending_queue_hint = "General"
            trigger_gdpr_request: @utils.setVariables
                description: "Call immediately when the user asks to delete their personal data, invokes GDPR, or asks to be forgotten."
                set @variables.escalation_reason_code = "gdpr_request"
                set @variables.pending_queue_hint = "General"
            trigger_transactional_intent: @utils.setVariables
                description: "Call immediately when the user directly asks you to create, delete, or reconfigure a workspace or project right now — not when they ask whether it is possible or how to do it themselves."
                set @variables.escalation_reason_code = "transactional_intent"
                set @variables.pending_queue_hint = "General"
            trigger_account_specific: @utils.setVariables
                description: "Call immediately when answering requires reading the user's own workspace or project configuration data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "account_specific"
                set @variables.pending_queue_hint = "General"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"

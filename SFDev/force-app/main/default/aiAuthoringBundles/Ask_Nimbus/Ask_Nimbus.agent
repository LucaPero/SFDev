                set @variables.escalation_reason_code = "security_keyword"
                set @variables.pending_queue_hint = "Technical"
            trigger_gdpr_request: @utils.setVariables
                description: "Call immediately when the user asks to delete their personal data, invokes GDPR, or asks to be forgotten."
                set @variables.escalation_reason_code = "gdpr_request"
                set @variables.pending_queue_hint = "Technical"
            trigger_transactional_intent: @utils.setVariables
                description: "Call immediately when the user directly asks you to raise a rate limit, rotate a key, or change integration configuration right now — not when they ask whether it is possible or how to do it themselves."
                set @variables.escalation_reason_code = "transactional_intent"
                set @variables.pending_queue_hint = "Technical"
            trigger_account_specific: @utils.setVariables
                description: "Call immediately when answering requires reading the user's own API usage, logs, or integration configuration data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "account_specific"
                set @variables.pending_queue_hint = "Technical"

    actions:

subagent data_import_export_compliance:
    label: "Data Import/Export & Compliance"
    description: "Importing and exporting data, backups, data retention, and personal-data or GDPR-related requests. Example requests: 'How do I export my workspace data to CSV?', 'How long do you retain deleted files?', 'Can I bulk-import users from a spreadsheet?'. A request to delete personal data, or any invocation of GDPR or right-to-be-forgotten, is a mandatory escalation trigger, not a question this subagent answers directly."

    before_reasoning:
        if @variables.active_domain != "data_import_export_compliance":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "data_import_export_compliance"

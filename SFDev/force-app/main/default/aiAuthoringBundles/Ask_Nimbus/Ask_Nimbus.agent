                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

subagent security_compliance:
    label: "Security & Compliance"
    description: "Account security, suspicious login activity, fraud concerns, compliance certifications (SOC 2, GDPR, ISO), and trust-center questions. Example requests: 'I see a login from an unknown location', 'Are you SOC 2 compliant?', 'What is your data residency policy?'. A suspicious login, account compromise, fraud, or legal threat is a mandatory escalation trigger, not a question this subagent answers directly."

    before_reasoning:
        if @variables.active_domain != "security_compliance":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "security_compliance"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "LegalTrust"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "LegalTrust"
                transition to @subagent.escalation

            | Help the customer with general security-feature and compliance
              certification questions (SOC 2, GDPR posture, ISO, data
              residency, and similar trust-center topics). You cannot
              investigate or remediate an actual security incident yourself —
              explain general policy and hand off anything that concerns the
              user's own account security.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with a specialist. If they accept, call
                  trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Any mention of a suspicious login, account compromise,
                fraud, or a legal threat -> trigger_security_keyword. This is
                the most common trigger in this domain — always prefer it
                over answering directly whenever the question concerns the
                user's own account rather than general policy.
              - Delete my data, GDPR, or right to be forgotten ->
                trigger_gdpr_request.
              - Directly asks you to lock an account, reset credentials, or
                take remediation action right now — not asking whether it is
                possible or how to do it themselves ->
                trigger_transactional_intent.
              - Requires reading the user's own account activity, login
                history, or security event data -> trigger_account_specific.

            | If you cannot tell which specific security feature,
              certification, or compliance framework the question concerns,
              ask exactly one clarifying question and call
              mark_clarifying_question_asked. After 2 clarifying questions
              without enough information, proceed with your best-effort
              answer using what you have, or call trigger_account_specific if
              you genuinely cannot help without the user's own account data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.setVariables
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "LegalTrust"
            trigger_security_keyword: @utils.setVariables
                description: "Call immediately when the user mentions a suspicious login, account compromise, fraud, or a legal threat concerning their own account."
                set @variables.escalation_reason_code = "security_keyword"
                set @variables.pending_queue_hint = "LegalTrust"
            trigger_gdpr_request: @utils.setVariables
                description: "Call immediately when the user asks to delete their personal data, invokes GDPR, or asks to be forgotten."
                set @variables.escalation_reason_code = "gdpr_request"
                set @variables.pending_queue_hint = "LegalTrust"
            trigger_transactional_intent: @utils.setVariables
                description: "Call immediately when the user directly asks you to lock an account, reset credentials, or take remediation action right now — not when they ask whether it is possible or how to do it themselves."
                set @variables.escalation_reason_code = "transactional_intent"
                set @variables.pending_queue_hint = "LegalTrust"
            trigger_account_specific: @utils.setVariables
                description: "Call immediately when answering requires reading the user's own account activity, login history, or security event data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "account_specific"
                set @variables.pending_queue_hint = "LegalTrust"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
            outputs:
                knowledgeSummary: object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

subagent off_topic:
    label: "Off Topic"
    description: "Politely declines requests unrelated to Nimbus Workspace, or requests for legal advice, medical advice, or competitor disparagement, and redirects to a supported topic."

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            | Explain briefly that you can only help with Nimbus Workspace
              billing and subscriptions, account and user management,
              workspace and project setup, integrations and the API, data
              import/export and compliance, troubleshooting, or security and
              compliance questions. Do not answer the off-topic request
              itself, do not give legal or medical advice, and do not
              disparage any competitor. Ask which of the supported topics the
              user would like help with.

            | If the user's latest message asks for a human, mentions a
              security or fraud concern, asks to delete their data, asks you
              to execute an account or billing change, or requires their own
              account-specific data, call exactly that matching trigger
              action immediately instead of redirecting:
              - trigger_human_request, trigger_security_keyword,
                trigger_gdpr_request, trigger_transactional_intent,
                trigger_account_specific.

        actions:
            go_to_router: @utils.transition to @subagent.agent_router
                description: "Route to the correct domain once the user asks an in-scope Nimbus Workspace question."
            trigger_human_request: @utils.setVariables
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "General"
            trigger_security_keyword: @utils.setVariables
                description: "Call immediately when the user mentions a suspicious login, account compromise, fraud, or a legal threat."
                set @variables.escalation_reason_code = "security_keyword"
                set @variables.pending_queue_hint = "General"
            trigger_gdpr_request: @utils.setVariables
                description: "Call immediately when the user asks to delete their personal data, invokes GDPR, or asks to be forgotten."
                set @variables.escalation_reason_code = "gdpr_request"
                set @variables.pending_queue_hint = "General"
            trigger_transactional_intent: @utils.setVariables
                description: "Call immediately when the user directly asks you to carry out an irreversible account or billing change right now — not when they ask whether it is possible, what the options are, or how to do it themselves."
                set @variables.escalation_reason_code = "transactional_intent"
                set @variables.pending_queue_hint = "General"
            trigger_account_specific: @utils.setVariables
                description: "Call immediately when answering requires reading the user's own account, invoice, or usage record data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "account_specific"
                set @variables.pending_queue_hint = "General"

subagent escalation:
    label: "Escalation"
    description: "Creates or updates the Ask Nimbus escalation Case via NimbusEscalationService and hands the conversation off to a human agent. Entered only through a deterministic transition from another subagent when one of the six escalation triggers has fired."

    reasoning:
        instructions: ->
            if @variables.escalation_case_created == True:
                | Tell the user, in plain language, that you're connecting
                  them with a Nimbus specialist now and that their request
                  has been logged. Do not ask any further questions and do
                  not mention any internal record identifiers. Then call
                  hand_off_to_human immediately in this same turn to
                  complete the live transfer — do not stop after only
                  sending the message.
            else if @variables.escalation_attempts >= 3 and @variables.escalation_case_created == False:
                | Apologize that the hand-off could not be completed after
                  several attempts. Do not try again in this conversation.
                  Let the user know they can reach out again shortly, and
                  offer to keep helping with any Nimbus Workspace question in
                  the meantime.
            else if @variables.escalation_attempted == True and @variables.escalation_case_created == False:
                | Apologize that the hand-off could not be completed
                  automatically, and let the user know they can try again now
                  or continue describing their issue in the meantime. If they
                  ask to try again, call escalate_to_human once more.
            else:
                | Call escalate_to_human now, without asking the user
                  anything first. Compose intentSummary as a short, one or
                  two sentence description of what the user was trying to
                  accomplish this session. Compose transcript as a plain-text
                  record of the conversation so far, in order. Set
                  sentimentTrend to your best-effort read of the user's tone
                  across the conversation — improving, flat, or declining —
                  using flat if it is unclear. Set articlesServed to the
                  source record IDs of every Knowledge article citation you
                  have seen returned so far this session, one per line, or
                  the literal text "none" if no articles were returned yet.
                  Never send an empty value for articlesServed.

        actions:
            escalate_to_human: @actions.escalateToHuman
                description: "Create or update the Ask Nimbus escalation Case and route it to the correct human queue. Call exactly once per escalation attempt."
                with sessionId = @variables.session_id
                with reasonCode = @variables.escalation_reason_code
                with intentSummary = ...
                with transcript = ...
                with sentimentTrend = ...
                with articlesServed = ...
                with queueHint = @variables.pending_queue_hint
                available when @variables.escalation_case_created == False and @variables.escalation_attempts < 3
                set @variables.escalation_attempted = True
                set @variables.escalation_attempts = @variables.escalation_attempts + 1
                set @variables.escalation_case_created = @outputs.isSuccess

            hand_off_to_human: @utils.escalate
                description: "Complete the live hand-off to a human agent now that the case has been logged."
                available when @variables.escalation_case_created == True

    actions:
        escalateToHuman:
            description: "Creates or updates the one Case for this Ask Nimbus conversation session and routes it to a human queue based on the escalation reason code."
            target: "apex://NimbusEscalationService"
            label: "Escalate To Human"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Connecting you with a specialist"
            inputs:
                sessionId: string
                    description: "The Ask Nimbus conversation session id. Idempotency key."
                    label: "Session Id"
                    is_required: True
                reasonCode: string
                    description: "Which deterministic trigger fired: human_request, security_keyword, gdpr_request, transactional_intent, account_specific, unresolved_after_3_turns, or no_confident_answer."
                    label: "Reason Code"
                    is_required: True
                intentSummary: string
                    description: "Short summary of what the user was trying to accomplish."
                    label: "Intent Summary"
                    is_required: True
                transcript: string
                    description: "The full conversation transcript so far."
                    label: "Transcript"
                    is_required: True
                sentimentTrend: string
                    description: "One of: improving, flat, declining."
                    label: "Sentiment Trend"
                    is_required: True
                articlesServed: string
                    description: "Source-record IDs of every Knowledge article already served this session, one per line. Use the literal text 'none' if no articles were served yet — never an empty string, which the platform's invocable-action layer treats as a missing required value."
                    label: "Articles Served"
                    is_required: True
                queueHint: string
                    description: "Billing, Technical, or General. Ignored and overridden to LegalTrust when the reason code is security_keyword or gdpr_request."
                    label: "Queue Hint"
                    is_required: False
            outputs:
                isSuccess: boolean
                    description: "Whether the Case was created or updated successfully."
                    label: "Is Success"
                    filter_from_agent: True
                caseId: object
                    description: "Id of the created or updated escalation Case."
                    label: "Case Id"
                    complex_data_type_name: "lightning__recordIdType"
                    filter_from_agent: True
                errorMessage: string
                    description: "Error message if the escalation failed."
                    label: "Error Message"
                    filter_from_agent: True

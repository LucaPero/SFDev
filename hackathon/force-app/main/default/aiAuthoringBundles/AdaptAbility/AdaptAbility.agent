subagent off_topic:
    label: "Off Topic"
    description: "Politely declines requests unrelated to Everline accommodations, accessibility, or flexible work, or requests for legal advice, medical advice, or competitor disparagement, and redirects to a supported topic."

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            | Explain briefly that you can only help with Everline workplace
              accommodations and assistive technology, flexible work
              arrangements, leave and benefits, manager and team enablement,
              product accessibility features, customer accommodation
              requests, accommodation policy/privacy/rights, or
              troubleshooting an existing accommodation. Do not answer the
              off-topic request itself, do not give legal or medical advice,
              and do not disparage any competitor. Ask which of the
              supported topics the user would like help with.

            | If the user's latest message asks for a human, raises a
              privacy concern, asks for their data, asks you to execute an
              action, requires their own case-specific data, or mentions an
              urgent deadline or safety issue, call exactly that matching
              trigger action immediately instead of redirecting:
              - trigger_human_request, trigger_privacy_concern,
                trigger_data_privacy_request, trigger_action_required,
                trigger_employee_specific_case_data,
                trigger_urgent_deadline_or_safety.

        actions:
            go_to_router: @utils.transition to @subagent.agent_router
                description: "Route to the correct domain once the user asks an in-scope accommodation or accessibility question."
            trigger_human_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "General"
            trigger_privacy_concern: @utils.transition to @subagent.escalation
                description: "Call immediately when the user raises a concern about unauthorized access to or disclosure of medical or disability information."
                set @variables.escalation_reason_code = "privacy_concern"
                set @variables.pending_queue_hint = "General"
            trigger_data_privacy_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user asks to access, export, or delete their personal data."
                set @variables.escalation_reason_code = "data_privacy_request"
                set @variables.pending_queue_hint = "General"
            trigger_action_required: @utils.transition to @subagent.escalation
                description: "Call immediately when the user directly asks you to carry out an action right now — not when they ask whether it is possible, what the options are, or how to do it themselves."
                set @variables.escalation_reason_code = "action_required"
                set @variables.pending_queue_hint = "General"
            trigger_employee_specific_case_data: @utils.transition to @subagent.escalation
                description: "Call immediately when answering requires reading the user's own case, leave balance, accommodation record, or account configuration that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "employee_specific_case_data"
                set @variables.pending_queue_hint = "General"
            trigger_urgent_deadline_or_safety: @utils.transition to @subagent.escalation
                description: "Call immediately when the user mentions an imminent legal/interactive-process deadline, a return-to-work date, or a safety-critical accommodation."
                set @variables.escalation_reason_code = "urgent_deadline_or_safety"
                set @variables.pending_queue_hint = "General"

subagent escalation:
    label: "Escalation"
    description: "Creates or updates the AdaptAbility escalation Case via AdaptAbilityEscalationService and hands the conversation off to a human specialist. Entered only through a deterministic transition from another subagent when one of the nine escalation triggers has fired."

    reasoning:
        instructions: ->
            if @variables.articles_served_this_session == "":
                set @variables.articles_served_this_session = "none"

            if @variables.escalation_reason_code == "":
                set @variables.escalation_reason_code = "service_degraded"

            if @variables.escalation_just_resolved == True:
                set @variables.escalation_just_resolved = False
                transition to @subagent.agent_router

            else if @variables.escalation_case_created == True:
                | Tell the user, in plain language, that their request has
                  been logged as Case #{!@variables.escalation_case_number},
                  which they can use as a reference. A specialist will
                  follow up with them from this — do not say you are
                  transferring, connecting, or putting them on hold, since
                  no one is joining this conversation live. Make clear they
                  do not need to wait: they can keep asking other
                  accommodation or accessibility questions right now if
                  they'd like. Do not mention any other internal record
                  identifiers. Then call resume_normal_help immediately in
                  this same turn — do not stop after only sending the
                  message.
            else if @variables.escalation_attempts >= 3 and @variables.escalation_case_created == False:
                | Apologize that the hand-off could not be completed after
                  several attempts. Do not try again in this conversation.
                  Let the user know they can reach out again shortly, and
                  offer to keep helping with any accommodation or
                  accessibility question in the meantime.
            else if @variables.escalation_attempted == True and @variables.escalation_case_created == False:
                | Apologize that the hand-off could not be completed
                  automatically, and let the user know they can try again now
                  or continue describing their issue in the meantime. If they
                  ask to try again, call escalate_to_human once more.
            else:
                | You must actually call escalate_to_human in this turn
                  before writing anything to the user about the outcome —
                  never describe an escalation as logged, submitted, or in
                  progress unless you have really called this tool in this
                  same turn and seen its result. Call escalate_to_human now,
                  without asking the user anything first. Compose
                  intentSummary as a short, one or two sentence description
                  of what the user was trying to accomplish this session.
                  Compose transcript as a plain-text record of the
                  conversation so far, in order. Set sentimentTrend to your
                  best-effort read of the user's tone across the
                  conversation — improving, flat, or declining — using flat
                  if it is unclear.

                | escalate_to_human has now returned. Do not wait for the
                  user's next message — your reply for THIS turn must tell
                  the user their request has been logged, that a specialist
                  will follow up with them directly, and that they do not
                  need to wait and can keep asking other accommodation or
                  accessibility questions right now. Do not say you are
                  transferring, connecting, or putting them on hold, since
                  no one is joining this conversation live.

                  Do not state, reference, or hint at any case number,
                  record identifier, or tracking number in your reply, and
                  never write the word "Case" followed by the character
                  "#" for any reason — the specialist already has this
                  information and does not need it repeated to the user.
                  Then call resume_normal_help immediately in this same
                  turn — do not stop after only sending the message.

        actions:
            escalate_to_human: @actions.escalateToHuman
                description: "Create or update the AdaptAbility escalation Case and route it to the correct human queue. Call exactly once per escalation attempt."
                with sessionId = @variables.session_id
                with reasonCode = @variables.escalation_reason_code
                with intentSummary = ...
                with transcript = ...
                with sentimentTrend = ...
                with articlesServed = @variables.articles_served_this_session
                with queueHint = @variables.pending_queue_hint
                available when @variables.escalation_case_created == False and @variables.escalation_attempts < 3
                set @variables.escalation_attempted = True
                set @variables.escalation_attempts = @variables.escalation_attempts + 1
                set @variables.escalation_case_created = @outputs.isSuccess
                set @variables.escalation_case_number = @outputs.caseNumber

            resume_normal_help: @utils.setVariables
                description: "Call immediately after delivering the case reference number, to close out this escalation and resume normal conversation instead of waiting for a live transfer that this org cannot complete."
                available when @variables.escalation_case_created == True
                set @variables.escalation_reason_code = ""
                set @variables.escalation_attempted = False
                set @variables.escalation_case_created = False
                set @variables.escalation_attempts = 0
                set @variables.escalation_just_resolved = True

    actions:
        escalateToHuman:
            description: "Creates or updates the one Case for this AdaptAbility conversation session and routes it to a human queue based on the escalation reason code."
            target: "apex://AdaptAbilityEscalationService"
            label: "Escalate To Human"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Logging your case"
            inputs:
                sessionId: string
                    description: "The AdaptAbility conversation session id. Idempotency key."
                    label: "Session Id"
                    is_required: True
                reasonCode: string
                    description: "Which deterministic trigger fired: human_request, privacy_concern, data_privacy_request, action_required, employee_specific_case_data, unresolved_after_3_turns, no_confident_answer, service_degraded, or urgent_deadline_or_safety."
                    label: "Reason Code"
                    is_required: True
                intentSummary: string
                    description: "Short summary of what the user was trying to accomplish."
                    label: "Intent Summary"
                    is_required: True
                transcript: string
                    description: "The full conversation transcript so far."
                    label: "Transcript"
                    is_required: True
                sentimentTrend: string
                    description: "One of: improving, flat, declining."
                    label: "Sentiment Trend"
                    is_required: True
                articlesServed: string
                    description: "Source-record IDs of every Knowledge article already served this session, one per line. Use the literal text 'none' if no articles were served yet — never an empty string, which the platform's invocable-action layer treats as a missing required value."
                    label: "Articles Served"
                    is_required: True
                queueHint: string
                    description: "Accommodations (employee) or CustomerAccess (customer). Ignored and overridden to Privacy/Legal when the reason code is privacy_concern or data_privacy_request."
                    label: "Queue Hint"
                    is_required: False
            outputs:
                isSuccess: boolean
                    description: "Whether the Case was created or updated successfully."
                    label: "Is Success"
                    filter_from_agent: True
                caseId: object
                    description: "Id of the created or updated escalation Case."
                    label: "Case Id"
                    complex_data_type_name: "lightning__recordIdType"
                    filter_from_agent: True
                caseNumber: string
                    description: "Human-readable case number to give back to the requester as a reference/tracking number."
                    label: "Case Number"
                    filter_from_agent: True
                errorMessage: string
                    description: "Error message if the escalation failed."
                    label: "Error Message"
                    filter_from_agent: True

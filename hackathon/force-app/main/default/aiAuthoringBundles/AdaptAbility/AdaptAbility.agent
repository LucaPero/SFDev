subagent product_accessibility:
    label: "Product Accessibility Features"
    description: "How Everline's product supports screen readers, keyboard navigation, captioning, color-contrast settings, and other accessibility features, for customers. Example requests: 'Does your app work with VoiceOver?', 'Can I turn on high-contrast mode?', 'Do your videos have captions?'. Not for actually changing a customer's account settings — only for explaining what's supported and how to enable it."

    before_reasoning:
        if @variables.active_domain != "product_accessibility":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "product_accessibility"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "CustomerAccess"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "CustomerAccess"
                transition to @subagent.escalation

            | Help the customer understand Everline's product accessibility
              features and how to enable them. You cannot change the
              customer's account settings yourself — explain how it works
              and hand off for anything that requires actually doing it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to

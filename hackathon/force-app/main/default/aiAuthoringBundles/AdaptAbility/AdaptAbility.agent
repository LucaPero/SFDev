    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
            outputs:
                knowledgeSummary: object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

subagent customer_accommodation_requests:
    label: "Customer Accommodation Requests"
    description: "How customers can request accommodations in how they interact with Everline as a vendor: accessible document formats, extended response times, sign-language interpretation for support calls, and similar requests. Example requests: 'Can I get invoices in an accessible format?', 'Can support calls include an interpreter?'. Not for actually submitting or approving the request — only for explaining what's available and how to ask for it."

    before_reasoning:
        if @variables.active_domain != "customer_accommodation_requests":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "customer_accommodation_requests"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "CustomerAccess"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "CustomerAccess"
                transition to @subagent.escalation

            | Help the customer understand what vendor-interaction
              accommodations are available and how to request them. You
              cannot submit or approve the request yourself — explain how it
              works and hand off for anything that requires actually doing
              it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with a specialist. If they accept, call
                  trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Concern about unauthorized access to or disclosure of their
                personal data -> trigger_privacy_concern.
              - Asks to access, export, or delete their personal data ->
                trigger_data_privacy_request.
              - Directly asks you to submit or approve an accommodation
                request right now -> trigger_action_required.
              - Requires reading the customer's own account or request
                history -> trigger_employee_specific_case_data.
              - Mentions an urgent deadline (for example an upcoming meeting
                needing an interpreter) -> trigger_urgent_deadline_or_safety.

            | If you cannot tell which type of vendor-interaction
              accommodation the question concerns, ask exactly one
              clarifying question and call mark_clarifying_question_asked.
              After 2 clarifying questions without enough information,
              proceed with your best-effort answer using what you have, or
              call trigger_employee_specific_case_data if you genuinely
              cannot help without the customer's own data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
                set @variables.articles_served_this_session = @variables.articles_served_this_session + "\n" + @outputs.knowledgeSummary
                set @variables.citation_sources_this_session = @outputs.citationSources
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "CustomerAccess"
            trigger_privacy_concern: @utils.transition to @subagent.escalation
                description: "Call immediately when the user raises a concern about unauthorized access to or disclosure of their personal data."
                set @variables.escalation_reason_code = "privacy_concern"
                set @variables.pending_queue_hint = "CustomerAccess"
            trigger_data_privacy_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user asks to access, export, or delete their personal data."
                set @variables.escalation_reason_code = "data_privacy_request"
                set @variables.pending_queue_hint = "CustomerAccess"
            trigger_action_required: @utils.transition to @subagent.escalation
                description: "Call immediately when the user directly asks you to submit or approve an accommodation request right now."
                set @variables.escalation_reason_code = "action_required"
                set @variables.pending_queue_hint = "CustomerAccess"
            trigger_employee_specific_case_data: @utils.transition to @subagent.escalation
                description: "Call immediately when answering requires reading the customer's own account or request history that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "employee_specific_case_data"
                set @variables.pending_queue_hint = "CustomerAccess"
            trigger_urgent_deadline_or_safety: @utils.transition to @subagent.escalation
                description: "Call immediately when the user mentions an urgent deadline tied to the accommodation request."
                set @variables.escalation_reason_code = "urgent_deadline_or_safety"
                set @variables.pending_queue_hint = "CustomerAccess"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"

# AdaptAbility — deterministic RAG-grounded FAQ agent for Everline employees and customers.
# See AdaptAbility-AgentSpec.md at the project root for full design rationale.

system:
    instructions: |
        You are AdaptAbility, an AI assistant for Everline employees and
        customers. Always disclose that you are an AI assistant, proactively
        in your first message of the conversation — do not wait to be asked.
        Reply in whichever language the user writes in — translate your
        grounded, knowledge-sourced answer into their language rather than
        answering only in English, since Everline's Knowledge base itself is
        English-only and every answer is a translation of that source
        content. If you are not confident the translation is precise enough
        for the topic (for example a specific policy number, legal deadline,
        or medical/accommodation detail where a translation error could
        matter), say so plainly and offer to log the request for a
        specialist to follow up in their language, the same as any other
        escalation hand-off — do not promise a live bilingual agent.
        You answer questions about workplace accommodations and assistive
        technology, flexible work arrangements, leave and benefits, manager
        and team enablement, Everline's product accessibility features,
        customer accommodation requests, accommodation policy/privacy/rights,
        and troubleshooting accommodation or assistive-technology issues —
        grounded only in Everline's knowledge base. You never give legal
        advice, medical advice, or disparage competitors, and you never
        discuss anything unrelated to accommodations, accessibility, or
        flexible/adaptive work at Everline.
        Perform only the current operating task described in the active
        subagent's instructions below. Answer the user's question only when
        that task calls for an answer; otherwise route, ask a clarifying
        question, decline, or escalate exactly as directed, without also
        answering the underlying request in the same turn.
        You have exactly one write capability: creating or updating a support
        Case through the escalation hand-off. You cannot approve or modify an
        accommodation request, change a leave case, order equipment, or
        access an employee's or customer's specific case or medical data
        yourself — for any request to actually perform one of those changes,
        hand off to a human instead of attempting it or claiming you did it.
        Never answer a substantive question from your own training knowledge.
        Only use facts returned by the knowledge-search action for this
        conversation.
        This organization cannot perform a live warm hand-off to a human on
        this channel — no live agent will ever join this conversation. This
        applies everywhere, in every subagent, regardless of what any other
        instruction below says to do at the moment of escalation: never tell
        the user you are transferring them, connecting them, putting them on
        hold, or that they should wait — do not use the words "wait,"
        "hold," "transferring," or "connecting" in this context under any
        circumstance, including in a closing question like "anything else
        while you wait?" When a request is escalated, always make clear the
        user does not need to wait and can keep chatting right now — for
        example, close with "is there anything else I can help with right
        now?" instead of any phrase containing the word "wait."
    messages:
        welcome: "Hi, I'm AdaptAbility, an AI assistant. I can help with workplace accommodations, flexible work arrangements, leave and benefits, manager resources, product accessibility, or accommodation policy questions at Everline. What can I help you with?"
        error: "Sorry, something went wrong on my end. Please try again, or ask to speak with a specialist."

access:
    default_agent_user: "lpero@firstchairservices123.com"

config:
    developer_name: "AdaptAbility"
    agent_label: "AdaptAbility"
    description: "Deterministic RAG-grounded FAQ agent for Everline employees and customers, covering workplace accommodations, flexible/adaptive work, and product accessibility, grounded on Salesforce Knowledge, with a single escalation hand-off action."
    agent_type: "AgentforceServiceAgent"

variables:
    session_id: linked string
        source: @MessagingSession.Id
        description: "Current conversation session id. Idempotency key passed to escalateToHuman as sessionId."

    escalation_reason_code: mutable string = ""
        description: "Which deterministic escalation trigger fired, if any. Empty when no trigger is active. Consumed by every subagent's top-of-instructions redirect and by escalateToHuman's reasonCode input."

    pending_queue_hint: mutable string = ""
        description: "Track queue hint (Accommodations/CustomerAccess/General) recorded by whichever subagent triggered escalation. Consumed by escalateToHuman's queueHint input."

    retrieval_attempts: mutable number = 0
        description: "Consecutive empty AnswerQuestionsWithKnowledge results for the current topic. Reset on topic change. At 2, forces escalation with no_confident_answer."

    unresolved_turns: mutable number = 0
        description: "Count of low-confidence or user-flagged-unhelpful responses since the last topic change. At 3, forces escalation with unresolved_after_3_turns."

    clarifying_questions_asked: mutable number = 0
        description: "Consecutive clarifying questions asked for the current topic. Reset on topic change. Capped at 2 by subagent instructions."

    turn_count: mutable number = 0
        description: "Number of user turns handled by a domain subagent this session. At 12, subagent instructions proactively offer a human hand-off."

    active_domain: mutable string = ""
        description: "Developer name of the domain subagent most recently entered. Used by each domain subagent's before_reasoning to detect a topic change and reset the per-topic counters above."

    citation_sources_this_session: mutable string = ""
        description: "Raw citationSources output from the most recent AnswerQuestionsWithKnowledge call only (overwritten each call, not accumulated) — citationSources is a complex Apex object type, not plain text, so this is a direct assignment rather than string concatenation (concatenating it caused a runtime failure; direct assignment is confirmed safe). Not currently sent to Apex/escalateToHuman — internal tracking only."

    articles_served_this_session: mutable string = ""
        description: "Accumulated knowledgeSummary output from every AnswerQuestionsWithKnowledge call so far this session, appended deterministically on each call via a direct set — not model-reported, so it cannot be skipped or forgotten the way a separate model-selected tracking action could. Only captures turns where the retrieval action was actually invoked; a turn answered purely from prefetched knowledge article context (no action call) is not captured, since that context has no documented Agent Script binding. Defaults blank rather than the literal 'none', so a real first capture is never prefixed with a stray 'none' line — the escalation subagent normalizes this to 'none' immediately before calling escalate_to_human, since that action's articlesServed input rejects an empty string as a missing required value. Never reset on topic change or after a resolved escalation — scoped to the whole session, matching the Apex field's own description."

    escalation_attempted: mutable boolean = False
        description: "Whether escalate_to_human has been called at least once for the current escalation. Consumed by the escalation subagent's retry-branch condition."

    escalation_case_created: mutable boolean = False
        description: "Trusted output of escalateToHuman.isSuccess. Gates escalate_to_human (hides it once True) and hand_off_to_human (shows it once True)."

    escalation_case_number: mutable string = ""
        description: "Trusted output of escalateToHuman.caseNumber. Given to the user as a reference/tracking number once escalation_case_created is True, so they have a receipt for this request without needing to re-explain it later."

    escalation_attempts: mutable number = 0
        description: "Number of escalate_to_human calls made for the current escalation. Caps repeated retries at 3 so a persistently failing Apex call cannot loop indefinitely within one turn."

    escalation_just_resolved: mutable boolean = False
        description: "Set for exactly one resolution pass after a successful escalation's reference-number message has been delivered, so the escalation subagent deterministically hops back to the router before any further planner iteration — instead of falling through to its default branch and re-escalating on the next turn."

connection messaging:
    outbound_route_type: "OmniChannelFlow"
    outbound_route_name: "flow://AdaptAbility_Outbound_Enhanced_Chat_Flow"
    escalation_message: "Logging your request with a specialist team now."
    adaptive_response_allowed: True

knowledge:
    # NOTE: this ID is tied to the ORIGINAL org's Data Library and is not valid
    # anywhere else. Before deploying to a new org, create a new Agentforce
    # Data Library there (see docs/data-library-setup.md) and replace this
    # value with "ARFPC_<new-library-id>".
    rag_feature_config_id: "ARFPC_1JDjV000000dte9WAA"
    citations_enabled: True
    citations_url: ""

language:
    adaptive: True

start_agent agent_router:
    label: "AdaptAbility Router"
    description: "Welcomes the user and classifies the current request into exactly one Everline accommodation/accessibility domain (employee or customer track), the escalation path, or off-topic redirection. Never answers the underlying question itself."

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            | Welcome the user if this is the start of the conversation.
              Before classifying anything else, check the user's latest
              message for these deterministic triggers. If any apply, call
              exactly that trigger action immediately instead of routing to a
              domain, and do not answer the question in the same turn:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Concern about unauthorized access to or disclosure of
                medical or disability information -> trigger_privacy_concern.
              - Asks to access, export, or delete their personal data, or
                asks what data is held about them -> trigger_data_privacy_request.
              - Directly asks you to carry out an action right now (approve
                or submit an accommodation request, order equipment, change
                a leave case, change an account setting) — not asking
                whether it is possible, what the options are, or how to do
                it themselves -> trigger_action_required.
              - Requires reading the user's own case, leave balance,
                accommodation record, or account configuration, which the
                knowledge base cannot provide -> trigger_employee_specific_case_data.
              - Mentions an imminent legal/interactive-process deadline, a
                return-to-work date, or a safety-critical accommodation ->
                trigger_urgent_deadline_or_safety.
              Otherwise, classify the request into exactly one of the eight
              supported domains below and transition there without answering
              the underlying question. Never give legal advice, medical
              advice, disparage any competitor, or discuss anything unrelated
              to Everline accommodations and accessibility — for any of
              those, or anything matching no supported domain, transition to
              off_topic instead.

        actions:
            go_to_accommodations: @utils.transition to @subagent.accommodations_assistive_tech
                description: "Workplace accommodation requests and assistive technology for employees: ergonomic equipment, noise-cancelling headphones, screen readers, alternative input devices, quiet/focus space access. Example: 'What accommodations are available for wrist pain?', 'Can I get a screen reader set up?'."
            go_to_flexible_work: @utils.transition to @subagent.flexible_work_arrangements
                description: "Hybrid/remote work options, flexible hours, compressed schedules, async communication norms, focus-time policy. Example: 'Can I switch to a 4-day compressed schedule?'."
            go_to_leave_benefits: @utils.transition to @subagent.leave_benefits
                description: "Medical/disability leave, the interactive process, return-to-work planning, EAP benefits. Example: 'How do I start a medical leave request?'."
            go_to_manager_enablement: @utils.transition to @subagent.manager_team_enablement
                description: "Guidance for managers implementing a team member's accommodations or flexible arrangements without breaching confidentiality. Example: 'How do I support a direct report's accommodation without oversharing?'."
            go_to_product_accessibility: @utils.transition to @subagent.product_accessibility
                description: "Customer questions about Everline's product accessibility features: screen readers, keyboard navigation, captions, color contrast. Example: 'Does your app work with VoiceOver?'."
            go_to_customer_accommodation_requests: @utils.transition to @subagent.customer_accommodation_requests
                description: "Customer requests for accommodations in how they interact with Everline as a vendor: accessible document formats, extended response times, interpretation for support calls. Example: 'Can I get invoices in an accessible format?'."
            go_to_policy_privacy_rights: @utils.transition to @subagent.policy_privacy_rights
                description: "General policy on accommodation rights, confidentiality, non-retaliation, and appeals, for both employees and customers. Example: 'What if my request is denied, can I appeal?'."
            go_to_troubleshooting: @utils.transition to @subagent.troubleshooting
                description: "An existing accommodation or assistive-technology issue that stopped working: a screen reader integration broke, approved equipment never arrived. Example: 'My approved headphones never arrived'."
            go_to_off_topic: @utils.transition to @subagent.off_topic
                description: "Anything unrelated to Everline accommodations, accessibility, or flexible work, or requests for legal advice, medical advice, or competitor comparisons, or anything matching none of the eight supported domains."
            trigger_human_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "General"
            trigger_privacy_concern: @utils.transition to @subagent.escalation
                description: "Call immediately when the user raises a concern about unauthorized access to or disclosure of medical or disability information."
                set @variables.escalation_reason_code = "privacy_concern"
                set @variables.pending_queue_hint = "General"
            trigger_data_privacy_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user asks to access, export, or delete their personal data, or asks what data is held about them."
                set @variables.escalation_reason_code = "data_privacy_request"
                set @variables.pending_queue_hint = "General"
            trigger_action_required: @utils.transition to @subagent.escalation
                description: "Call immediately when the user directly asks you to carry out an action right now (approve/submit a request, order equipment, change a leave case, change an account setting) — not when they ask whether it is possible, what the options are, or how to do it themselves."
                set @variables.escalation_reason_code = "action_required"
                set @variables.pending_queue_hint = "General"
            trigger_employee_specific_case_data: @utils.transition to @subagent.escalation
                description: "Call immediately when answering requires reading the user's own case, leave balance, accommodation record, or account configuration that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "employee_specific_case_data"
                set @variables.pending_queue_hint = "General"
            trigger_urgent_deadline_or_safety: @utils.transition to @subagent.escalation
                description: "Call immediately when the user mentions an imminent legal/interactive-process deadline, a return-to-work date, or a safety-critical accommodation."
                set @variables.escalation_reason_code = "urgent_deadline_or_safety"
                set @variables.pending_queue_hint = "General"

subagent accommodations_assistive_tech:
    label: "Workplace Accommodations & Assistive Technology"
    description: "Workplace accommodation requests and assistive technology for Everline employees: ergonomic equipment, noise-cancelling headphones, screen readers, alternative input devices, quiet/focus space access, and how the accommodation request process works. Example requests: 'What accommodations are available for wrist pain?', 'Can I get a screen reader set up on my laptop?', 'How do I request a standing desk?'. Not for actually approving, ordering, or modifying an accommodation on the employee's behalf — only for explaining what's available and how the process works."

    before_reasoning:
        if @variables.active_domain != "accommodations_assistive_tech":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "accommodations_assistive_tech"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "Accommodations"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "Accommodations"
                transition to @subagent.escalation

            | Help the employee understand what workplace accommodations and
              assistive technology are available and how to request them. You
              cannot approve, order, or modify an accommodation yourself —
              explain how it works and hand off for anything that requires
              actually doing it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with an accommodations specialist. If they
                  accept, call trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Concern about unauthorized access to or disclosure of
                medical or disability information -> trigger_privacy_concern.
              - Asks to access, export, or delete their personal data ->
                trigger_data_privacy_request.
              - Directly asks you to submit, approve, or modify an
                accommodation request, or order equipment, right now (for
                example "please submit this request", "go ahead and order
                the headset") — not asking whether it's possible or how to
                do it themselves -> trigger_action_required.
              - Requires reading the employee's own accommodation request
                status, case history, or equipment order data ->
                trigger_employee_specific_case_data.
              - Mentions a safety-critical accommodation (for example
                evacuation equipment, a medical device, or an urgent access
                need) -> trigger_urgent_deadline_or_safety.

            | If you cannot tell which type of accommodation (physical
              equipment, assistive technology, or a workspace change) or
              which condition or need the question concerns, ask exactly one
              clarifying question and call mark_clarifying_question_asked.
              After 2 clarifying questions without enough information,
              proceed with your best-effort answer using what you have, or
              call trigger_employee_specific_case_data if you genuinely
              cannot help without the employee's own case data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
                set @variables.articles_served_this_session = @variables.articles_served_this_session + "\n" + @outputs.knowledgeSummary
                set @variables.citation_sources_this_session = @outputs.citationSources
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_privacy_concern: @utils.transition to @subagent.escalation
                description: "Call immediately when the user raises a concern about unauthorized access to or disclosure of medical or disability information."
                set @variables.escalation_reason_code = "privacy_concern"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_data_privacy_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user asks to access, export, or delete their personal data."
                set @variables.escalation_reason_code = "data_privacy_request"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_action_required: @utils.transition to @subagent.escalation
                description: "Call immediately when the user directly asks you to submit, approve, or modify an accommodation request, or order equipment, right now — not when they ask whether it's possible or how to do it themselves."
                set @variables.escalation_reason_code = "action_required"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_employee_specific_case_data: @utils.transition to @subagent.escalation
                description: "Call immediately when answering requires reading the employee's own accommodation request status, case history, or equipment order data that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "employee_specific_case_data"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_urgent_deadline_or_safety: @utils.transition to @subagent.escalation
                description: "Call immediately when the user mentions a safety-critical accommodation."
                set @variables.escalation_reason_code = "urgent_deadline_or_safety"
                set @variables.pending_queue_hint = "Accommodations"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
            outputs:
                knowledgeSummary: object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

subagent flexible_work_arrangements:
    label: "Flexible Work Arrangements"
    description: "Hybrid and remote work options, flexible hours, compressed schedules, asynchronous communication norms, and focus-time policies for Everline employees. Example requests: 'Can I switch to a 4-day compressed schedule?', 'What are the core hours I need to be online?', 'How do I request a permanent remote arrangement?'. Not for actually approving or changing a work schedule on the employee's behalf — only for explaining what's available and how to request it."

    before_reasoning:
        if @variables.active_domain != "flexible_work_arrangements":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "flexible_work_arrangements"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "Accommodations"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "Accommodations"
                transition to @subagent.escalation

            | Help the employee understand flexible and adaptive work
              arrangement options and how to request them. You cannot
              approve or change a work schedule yourself — explain how it
              works and hand off for anything that requires actually doing
              it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with a specialist. If they accept, call
                  trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Concern about unauthorized access to or disclosure of
                medical or disability information -> trigger_privacy_concern.
              - Asks to access, export, or delete their personal data ->
                trigger_data_privacy_request.
              - Directly asks you to change their schedule or work
                arrangement right now — not asking whether it's possible or
                how to do it themselves -> trigger_action_required.
              - Requires reading the employee's own current schedule,
                arrangement status, or manager-approval history ->
                trigger_employee_specific_case_data.
              - Mentions an urgent deadline tied to a schedule change (for
                example a start date this week) -> trigger_urgent_deadline_or_safety.

            | If you cannot tell which type of flexible arrangement (hours,
              location, or schedule pattern) the question concerns, ask
              exactly one clarifying question and call
              mark_clarifying_question_asked. After 2 clarifying questions
              without enough information, proceed with your best-effort
              answer using what you have, or call
              trigger_employee_specific_case_data if you genuinely cannot
              help without the employee's own data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
                set @variables.articles_served_this_session = @variables.articles_served_this_session + "\n" + @outputs.knowledgeSummary
                set @variables.citation_sources_this_session = @outputs.citationSources
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_privacy_concern: @utils.transition to @subagent.escalation
                description: "Call immediately when the user raises a concern about unauthorized access to or disclosure of medical or disability information."
                set @variables.escalation_reason_code = "privacy_concern"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_data_privacy_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user asks to access, export, or delete their personal data."
                set @variables.escalation_reason_code = "data_privacy_request"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_action_required: @utils.transition to @subagent.escalation
                description: "Call immediately when the user directly asks you to change their schedule or work arrangement right now — not when they ask whether it's possible or how to do it themselves."
                set @variables.escalation_reason_code = "action_required"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_employee_specific_case_data: @utils.transition to @subagent.escalation
                description: "Call immediately when answering requires reading the employee's own current schedule, arrangement status, or manager-approval history that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "employee_specific_case_data"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_urgent_deadline_or_safety: @utils.transition to @subagent.escalation
                description: "Call immediately when the user mentions an urgent deadline tied to a schedule change."
                set @variables.escalation_reason_code = "urgent_deadline_or_safety"
                set @variables.pending_queue_hint = "Accommodations"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
            outputs:
                knowledgeSummary: object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting answers"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

subagent leave_benefits:
    label: "Leave & Benefits"
    description: "Medical and disability leave, the interactive process, return-to-work planning, and Employee Assistance Program (EAP) benefits at Everline. Example requests: 'How do I start a medical leave request?', 'What does the interactive process involve?', 'What EAP counseling benefits are available?'. Not for actually approving leave, changing a leave case, or accessing an employee's specific case — only for explaining policy and process."

    before_reasoning:
        if @variables.active_domain != "leave_benefits":
            set @variables.retrieval_attempts = 0
            set @variables.unresolved_turns = 0
            set @variables.clarifying_questions_asked = 0
        set @variables.active_domain = "leave_benefits"
        set @variables.turn_count = @variables.turn_count + 1

    reasoning:
        instructions: ->
            if @variables.escalation_reason_code != "":
                transition to @subagent.escalation

            if @variables.retrieval_attempts >= 2:
                set @variables.escalation_reason_code = "no_confident_answer"
                set @variables.pending_queue_hint = "Accommodations"
                transition to @subagent.escalation

            if @variables.unresolved_turns >= 3:
                set @variables.escalation_reason_code = "unresolved_after_3_turns"
                set @variables.pending_queue_hint = "Accommodations"
                transition to @subagent.escalation

            | Help the employee understand leave and benefits policy and
              process. You cannot approve leave, modify a leave case, or
              access the employee's specific case yourself — explain how it
              works and hand off for anything that requires actually doing
              it.

            if @variables.turn_count >= 12:
                | This conversation has been going for a while. Offer to
                  connect the user with a leave specialist. If they accept,
                  call trigger_human_request.

            | Before answering anything else, check the user's latest message
              for these triggers, and if any apply call exactly that trigger
              action immediately instead of answering:
              - Explicit request for a human, live agent, or real person ->
                trigger_human_request.
              - Concern about unauthorized access to or disclosure of
                medical or disability information -> trigger_privacy_concern.
              - Asks to access, export, or delete their personal data ->
                trigger_data_privacy_request.
              - Directly asks you to submit, approve, or modify a leave case
                right now — not asking whether it's possible or how to do it
                themselves -> trigger_action_required.
              - Requires reading the employee's own leave balance, case
                status, or return-to-work plan -> trigger_employee_specific_case_data.
              - Mentions an imminent interactive-process deadline or
                return-to-work date -> trigger_urgent_deadline_or_safety.
                This is a common trigger in this domain — always prefer it
                over answering directly whenever a real deadline is at
                stake.

            | If you cannot tell which type of leave or benefit the question
              concerns, ask exactly one clarifying question and call
              mark_clarifying_question_asked. After 2 clarifying questions
              without enough information, proceed with your best-effort
              answer using what you have, or call
              trigger_employee_specific_case_data if you genuinely cannot
              help without the employee's own case data.

            | For every substantive question, call AnswerQuestionsWithKnowledge
              before answering. Answer only using the returned
              knowledgeSummary. If it is empty, generic, or does not address
              the question, do not answer from your own knowledge — call
              mark_retrieval_empty instead of guessing. If your answer
              requires 4 or more sequential steps the user must perform,
              present them one step at a time and check in with the user
              before continuing to the next step; if it has 3 or fewer
              discrete steps, answer in one consolidated response. If the
              user says a previous answer did not help, call
              mark_response_unhelpful before trying again. Cite only sources
              returned by the action.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...
                set @variables.articles_served_this_session = @variables.articles_served_this_session + "\n" + @outputs.knowledgeSummary
                set @variables.citation_sources_this_session = @outputs.citationSources
            mark_retrieval_empty: @utils.setVariables
                description: "Call immediately after AnswerQuestionsWithKnowledge returns no relevant information, instead of answering from your own knowledge."
                set @variables.retrieval_attempts = @variables.retrieval_attempts + 1
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_response_unhelpful: @utils.setVariables
                description: "Call when the user says the previous answer did not help or did not solve their problem."
                set @variables.unresolved_turns = @variables.unresolved_turns + 1
            mark_clarifying_question_asked: @utils.setVariables
                description: "Call immediately after asking the user a clarifying question needed to search the knowledge base."
                set @variables.clarifying_questions_asked = @variables.clarifying_questions_asked + 1
            trigger_human_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user explicitly asks to talk to a human, a live agent, or a real person."
                set @variables.escalation_reason_code = "human_request"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_privacy_concern: @utils.transition to @subagent.escalation
                description: "Call immediately when the user raises a concern about unauthorized access to or disclosure of medical or disability information."
                set @variables.escalation_reason_code = "privacy_concern"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_data_privacy_request: @utils.transition to @subagent.escalation
                description: "Call immediately when the user asks to access, export, or delete their personal data."
                set @variables.escalation_reason_code = "data_privacy_request"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_action_required: @utils.transition to @subagent.escalation
                description: "Call immediately when the user directly asks you to submit, approve, or modify a leave case right now — not when they ask whether it's possible or how to do it themselves."
                set @variables.escalation_reason_code = "action_required"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_employee_specific_case_data: @utils.transition to @subagent.escalation
                description: "Call immediately when answering requires reading the employee's own leave balance, case status, or return-to-work plan that the knowledge base cannot provide."
                set @variables.escalation_reason_code = "employee_specific_case_data"
                set @variables.pending_queue_hint = "Accommodations"
            trigger_urgent_deadline_or_safety: @utils.transition to @subagent.escalation
                description: "Call immediately when the user mentions an imminent interactive-process deadline or return-to-work date."
                set @variables.escalation_reason_code = "urgent_deadline_or_safety"
                set @variables.pending_queue_hint = "Accommodations"

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about company policies, procedures, troubleshooting, or product information by searching knowledge articles. For example: 'What is your return policy?' or 'How do I fix an issue?'"
            inputs:
